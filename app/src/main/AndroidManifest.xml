<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <queries>
        <package android:name="com.tencent.mm" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WeChatPhotoCall"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.WeChatPhotoCall">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ContactEditActivity"
            android:exported="false"
            android:label="@string/edit_contact"
            android:parentActivityName=".SettingsActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AutomationStepsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.WeChatPhotoCall" />

        <activity
            android:name=".CropImageActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.WeChatPhotoCall" />

        <activity
            android:name=".CalibrationActivity"
            android:exported="false"
            android:label="@string/calibration"
            android:parentActivityName=".SettingsActivity" />

        <!-- 独立进程：避免主界面退到后台后被 ColorOS 冻结导致点不动微信 -->
        <service
            android:name=".service.PhotoCallAccessibilityService"
            android:exported="false"
            android:label="@string/a11y_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:process=":a11y"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 与无障碍同进程的保活前台服务 -->
        <service
            android:name=".service.CallKeepAliveService"
            android:exported="false"
            android:process=":a11y"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="auto_click_keep_alive" />
        </service>

        <service
            android:name=".service.CalibrationOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="coordinate_calibration_overlay" />
        </service>
    </application>
</manifest>
